# Copia este archivo a .env.local y rellena los valores.
# Config de la app web: firebase apps:sdkconfig WEB --project finanzasd-app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# uid de tu cuenta de Google en Firebase Auth (se muestra tras el primer login)
VITE_OWNER_UID=
